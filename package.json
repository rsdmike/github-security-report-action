{
  "name": "github-security-report",
  "version": "4.1.0",
  "description": "Generates a report from GitHub CodeQL and Dependency information",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "package": "npm run build && ncc build && node scripts/copy-templates.mjs",
    "test:dist": "node scripts/verify-dist.mjs",
    "postpack": "tarball=$(npm list - depth 0 | sed 's/@/-/g; s/ .*/.tgz/g; 1q;'); tar -tf $tarball | sed 's/^package\\///' | zip -@r github-security-report-bundle",
    "test": "mocha --recursive --reporter-option maxDiffSize=16384 --extension ts \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "Peter Murray",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/io": "^3.0.2",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "dompurify": "^3.0.6",
    "jsdom": "^28.1.0",
    "marked": "^18.0.11",
    "nunjucks": "^3.2.4",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@octokit/types": "^17.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/sinon": "^22.0.0",
    "@vercel/ncc": "^0.45.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.5",
    "mocha": "^11.8.0",
    "neostandard": "^0.13.0",
    "sinon": "^22.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.1.0"
    }
  }
}
