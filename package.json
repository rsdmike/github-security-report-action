{
  "name": "github-security-report",
  "version": "4.0.0",
  "description": "Generates a report from GitHub CodeQL and Dependency information",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "package": "npm run build && ncc build",
    "postpack": "tarball=$(npm list - depth 0 | sed 's/@/-/g; s/ .*/.tgz/g; 1q;'); tar -tf $tarball | sed 's/^package\\///' | zip -@r github-security-report-bundle",
    "test": "mocha --node-option no-experimental-strip-types --recursive --reporter-option maxDiffSize=16384 -r ts-node/register \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "Peter Murray",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/io": "^2.0.0",
    "@octokit/rest": "^20.0.1",
    "commander": "^15.0.0",
    "dompurify": "^3.0.6",
    "jsdom": "^28.1.0",
    "marked": "^11.1.0",
    "nunjucks": "^3.2.4",
    "nunjucks-markdown": "^2.0.1",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@octokit/types": "^12.4.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/sinon": "^22.0.0",
    "@vercel/ncc": "^0.45.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.5",
    "mocha": "^11.8.0",
    "neostandard": "^0.13.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.1.0"
    }
  }
}
